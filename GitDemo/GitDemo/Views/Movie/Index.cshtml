@model IEnumerable<GitDemo.Models.Movie>

@{
    ViewBag.Title = "Movies List";
}

<h2>Movies List</h2>

<p>
    @Html.ActionLink("Create New Movie", "Create")
</p>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Id</th>
            <th>Name</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var movie in Model)
        {
            <tr>
                <td>@movie.Id</td>
                <td>@movie.Name</td>
                <td>
                    @Html.ActionLink("Details", "Details", new { id = movie.Id }) |
                    @Html.ActionLink("Edit", "Edit", new { id = movie.Id }) |
                    @Html.ActionLink("Delete", "Delete", new { id = movie.Id })
                </td>
            </tr>
        }
    </tbody>
</table>
