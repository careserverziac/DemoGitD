@model GitDemo.Models.Movie

@{
    ViewBag.Title = "Delete Movie";
}

<h2>Delete Movie</h2>

<h4>Are you sure you want to delete this movie?</h4>

<div>
    <strong>Movie ID:</strong> @Model.Id <br />
    <strong>Name:</strong> @Model.Name
</div>

@using (Html.BeginForm("DeleteConfirmed", "Movie", new { id = Model.Id }, FormMethod.Post))
{
    <button type="submit" class="btn btn-danger">Delete</button>
    @Html.ActionLink("Cancel", "Index", null, new { @class = "btn btn-secondary" })
}
